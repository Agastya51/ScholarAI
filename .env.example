# Groq API Key (Required for LLM and Vision models)
GROQ_API_KEY=your_groq_api_key_here

# Agent budgets (LLM calls per request / per multi-agent run)
MAX_LLM_CALLS_PER_RUN=40
MAX_LLM_CALLS_ANALYZE=90

# Flask Configuration (keep FLASK_DEBUG=False on a public server)
FLASK_DEBUG=False
PORT=5000

# ---- Retrieval (all optional; defaults shown) ----
# Chunks handed to the LLM per question
# DEFAULT_TOP_K=4
# Maximal Marginal Relevance: less repetitive context
# USE_MMR=True
# Query rewriting + HyDE: off | auto (only when evidence is weak, +1 LLM call) | always
# QUERY_EXPANSION=auto
# Reranker: none | cross-encoder (loads a second model, needs more RAM) | llm (+1 LLM call)
# RERANK_MODE=none
# Similarity thresholds. Run `python -m evals.retrieval_eval ...` once: it prints suggested values.
# MIN_RELEVANCE=0.40
# HIGH_CONFIDENCE=0.60

# ---- Multi-user limits (all optional; defaults shown) ----
# SESSION_ISOLATION=True
# MAX_SESSIONS=8
# SESSION_TTL_SECONDS=10800
# MAX_PAPERS_PER_SESSION=6
# MAX_UPLOAD_MB=25
# MAX_PDF_PAGES=60
